# Copy to .env.local and fill in. Everything here is read only by the server process.

# --- AI generation (optional) ---------------------------------------------------
# Without it, REMIX uses its local rule-based engine (labeled in the UI).
ANTHROPIC_API_KEY=

# --- GitHub OAuth App -----------------------------------------------------------
# https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:5180
#   Authorization callback URL: http://localhost:5180/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to true to request the `repo` scope (includes private repositories).
# Default requests only `read:user` (public repositories + profile).
GITHUB_INCLUDE_PRIVATE=false

# --- Google OAuth 2.0 client (YouTube) ------------------------------------------
# https://console.cloud.google.com -> APIs & Services
#   1. Enable "YouTube Data API v3"
#   2. OAuth consent screen: External, add yourself as a Test user,
#      add scope .../auth/youtube.readonly
#   3. Credentials -> Create OAuth client ID -> Web application
#      Authorized redirect URI: http://localhost:5180/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sessions / credential encryption --------------------------------------------
# 32+ random characters; encrypts stored OAuth tokens (AES-256-GCM) in .data/.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset in local dev, a random secret is generated once into .data/session-secret.
REMIX_SESSION_SECRET=

# Public URL of this app (must match the OAuth redirect URIs). Default: http://localhost:5180
REMIX_BASE_URL=
