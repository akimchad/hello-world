static func copy(p: Dictionary) -> Dictionary:
	return p.duplicate()

static func lerp_into(o: Dictionary, a: Dictionary, b: Dictionary, t: float) -> void:
	for j in JOINTS: o[j] = a[j].lerp(b[j], t)
	for s in SCALARS: o[s] = lerpf(a[s], b[s], t)

static func add(p: Dictionary, j: String, x := 0.0, y := 0.0, z := 0.0) -> void:
	p[j] = p[j] + Vector3(x, y, z)
